{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portreaper",
  "version": "0.11.0",
  "identifier": "com.fhf.portreaper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Portreaper",
        "width": 1460,
        "height": 760,
        "minWidth": 960,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 fhf. MIT License.",
    "publisher": "fhf",
    "homepage": "https://fanhefeng.github.io/portreaper/",
    "shortDescription": "Find and kill orphaned dev-server processes",
    "longDescription": "Portreaper is a menubar/tray utility that finds processes listening on TCP ports, classifies which of them are orphaned dev-server leftovers, and helps you reap them. It also surfaces orphaned dev processes that hold no port at all.",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2N0I0QzZGRjUxNjhCQUEKUldTcWl4YjFiMHg3UnN3V2FiNDVtUlJlaVFwNmlidExIZHF4blBmak5Dck9lY2xCeHlXLzlyanQK",
      "endpoints": ["https://github.com/fanhefeng/portreaper/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
