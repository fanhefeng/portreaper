{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // 本 project 只覆盖 webview 应用代码，**刻意不含 node 类型**（评审发现：
    // 此前 "types": ["node"] 为测试文件把 Node 全局带进了整个 src/ ——
    // webview 代码误用 process.env/Buffer 能通过 tsc，只在运行时暴露）。
    // 需要 node:fs/process 的测试走 tsconfig.test.json，跑在 Node 里的两个构建
    // 配置文件走 tsconfig.node.json（两者都含 node 类型）；
    // `pnpm run typecheck` 三个 project 都查，CI/pre-push/`pnpm build` 用的就是它。
    "types": [],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // 测试与其夹具库归 tsconfig.test.json 管，构建配置文件归 tsconfig.node.json 管
  //（两边才有 node 类型）。三个 project 都由 `pnpm run typecheck` 显式跑 ——
  // 刻意不用 "references"：`tsc --noEmit` 不跟随它，挂上去等于查了个寂寞。
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-fixtures.ts"]
}
